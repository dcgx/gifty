#BUSCAR ELEMENTO
# Crear un diccionario que represente el inventario
productos = {
    'giftcard': 50,
    'flores': 30,
    'chocolates': 50,
    'tazones': 15
}

# Función para buscar un elemento en el inventario
def buscar_elemento(productos, elemento):
    if elemento in productos:
        cantidad = productos[elemento]
        return f"El inventario tiene una cantidad de {cantidad} {elemento}."
    else:
        return f"{elemento} no se encuentra en el inventario."


elemento_buscado = 'giftcard'
resultado = buscar_elemento(productos, elemento_buscado)
print(resultado)

